# ============================================================================
# GARDEN GNOME — environment variables
# Copy this file to .env.local and fill in values.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — Supabase connection (get from Supabase dashboard → Project Settings → API)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ----------------------------------------------------------------------------
# REQUIRED for property setup — Google Maps (frontend, restrict to your domain)
# Enable: Maps JavaScript API + Places API + Geocoding API
# ----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------------------------
# OPTIONAL — features gracefully disabled if missing
# ----------------------------------------------------------------------------

# Weather on dashboard
OPENWEATHER_API_KEY=

# Historical frost dates (free token, takes ~1 day to issue)
NOAA_API_TOKEN=

# Plant photo enrichment
PERENUAL_API_KEY=

# AI gnome features (if you want LLM-powered planning suggestions)
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# NOT NEEDED — these run on free public APIs with no key
# ----------------------------------------------------------------------------
# USDA Plant Hardiness Zone API   (planthardiness.ars.usda.gov)
# USDA Soil Data Access (SSURGO)  (sdmdataaccess.sc.egov.usda.gov)
